# ── SeekJob backend environment ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

SEEKJOB_SECRET=dev-secret-change-in-production-min-32-chars!!

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8020

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI to register: http://localhost:8020/applicant/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers → OAuth Apps
# Callback URL to register: http://localhost:8020/applicant/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
